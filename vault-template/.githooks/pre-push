#!/bin/sh
# push の前に LLM Wiki の機械の点検を走らせる。
# 有効にするには、clone した wiki で一度だけ: git config core.hooksPath .githooks
#
# 送り先にすでにあるコミット(新しいブランチなら送り先の既定ブランチ)と、push するコミットを比べる。
remote="$1"
# vault の場所はこのフックの 1 つ上(vault がリポジトリのサブフォルダでも動く)
root=$(cd "$(dirname "$0")/.." && pwd)

py=""
for candidate in python3 python; do
  if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)" >/dev/null 2>&1; then
    py="$candidate"
    break
  fi
done
if [ -z "$py" ]; then
  echo "wiki-lint: Python 3.9 以上が見つからないので、点検できず push を止めた" >&2
  exit 1
fi

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # ブランチの削除は点検しない
  case "$remote_sha" in
    *[!0]*) base="$remote_sha" ;;
    *) base=$(git rev-parse --verify --quiet "refs/remotes/$remote/HEAD") || base="" ;;
  esac
  # stdin は git が渡す ref の一覧なので、点検には渡さない
  if [ -n "$base" ]; then
    "$py" "$root/scripts/wiki_lint.py" --base "$base" --head "$local_sha" </dev/null || status=1
  else
    "$py" "$root/scripts/wiki_lint.py" --head "$local_sha" </dev/null || status=1
  fi
done
exit $status
